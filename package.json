{
  "name": "extensible",
  "version": "1.1.0",
  "description": "Modular Web Extension Suite (WXT + Svelte 5) with TempMail autofill, inbox reader and AI chat export",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:all": "wxt build -b chrome && wxt build -b firefox && wxt build -b edge",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:all": "wxt zip -b chrome && wxt zip -b firefox && wxt zip -b edge",
    "pack": "pnpm run zip:all && node scripts/pack.js all",
    "pack:crx": "node scripts/pack.js crx",
    "pack:xpi": "node scripts/pack.js xpi",
    "pack:all": "pnpm run zip:all && node scripts/pack.js all",
    "compile": "wxt prepare",
    "icons": "node scripts/generate_icons.js",
    "typecheck": "wxt prepare && tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts",
    "format": "biome format --write src test scripts",
    "test": "npx -y tsx test/verify_model.ts"
  },
  "keywords": [
    "chrome-extension",
    "wxt",
    "svelte",
    "tempmail",
    "autofill",
    "inbox",
    "mv3"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "crx3": "^2.0.0",
    "knip": "^6.34.0",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wxt": "^0.21.4"
  },
  "knip": {
    "entry": [
      "src/entrypoints/background/index.ts",
      "src/entrypoints/content/index.ts",
      "src/entrypoints/popup/main.ts"
    ],
    "project": [
      "src/**/*.{ts,svelte}",
      "!src/entrypoints/**"
    ],
    "ignoreDependencies": [
      "tailwindcss"
    ]
  }
}
