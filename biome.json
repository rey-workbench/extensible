{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "!src/styles/**", "entrypoints/**", "test/**", "scripts/**"],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        },
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "warn",
        "noUnusedPrivateClassMembers": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noUnsafeDeclarationMerging": "error",
        "useAwait": "warn",
        "noAsyncPromiseExecutor": "error",
        "noConstEnum": "error"
      },
      "style": {
        "useImportType": {
          "level": "error",
          "fix": "safe"
        },
        "useExportType": {
          "level": "error",
          "fix": "safe"
        },
        "useAsConstAssertion": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useShorthandFunctionType": "error",
        "useLiteralEnumMembers": "error",
        "useEnumInitializers": "error",
        "useNodejsImportProtocol": {
          "level": "error",
          "fix": "safe"
        },
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noEmptyTypeParameters": "error",
        "noUselessTypeConstraint": "error",
        "noUselessEmptyExport": "error",
        "noStaticOnlyClass": "off",
        "noThisInStatic": "off",
        "noImportantStyles": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
